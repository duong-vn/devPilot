# Copy to .env.local and fill values locally. Never commit real configuration.
APP_URL=http://localhost:3000
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Disabled in production unless explicitly true. Local development enables demo automatically.
ENABLE_DEMO=false
