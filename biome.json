{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.config.ts",
      "*.config.mjs",
      "!!.next",
      "!!node_modules",
      "!!playwright-report",
      "!!test-results",
      "!!package-lock.json",
      "!!next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
