{
  "name": "devpilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.71",
    "ai": "7.0.107",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "postgres": "^3.4.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
